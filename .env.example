# Servidor
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/identity

# JWT
JWT_SECRET=mude-isso-em-producao-minimo-32-caracteres
JWT_CUSTOMER_EXPIRES_IN=1h
JWT_ADMIN_EXPIRES_IN=8h

# Serviços externos
ORDER_SERVICE_URL=http://localhost:3001
ORDER_SERVICE_TIMEOUT_MS=2000

# Observabilidade
CORRELATION_ID_HEADER=x-correlation-id

# Seed admin
SEED_ADMIN_EMAIL=admin@autoflow.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Administrador
